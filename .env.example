# SC Dossier — Environment Variables
# Copy this file to .env and fill in your values.
# The app reads these at startup; if unset, falls back to defaults in constants.py.

# Supabase Configuration for Reputation System
REP_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
REP_ANON_KEY=your-anon-key-here
REP_APP_TOKEN=your-app-token-here
